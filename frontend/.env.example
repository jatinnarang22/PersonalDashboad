# Frontend-only env (do not put API secrets here).

# Dev: Vite proxies /api → http://127.0.0.1:${VITE_DEV_API_PORT} (default 3000).
# Start the backend separately: cd ../backend && npm run dev
# VITE_DEV_API_PORT=3000

# Production build: full API base URL (must end with /api or host only — see src/services/api.js).
# VITE_API_URL=http://localhost:3000/api
